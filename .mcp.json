{
  "mcpServers": {
    "twenty-rise": {
      "type": "http",
      "url": "https://crm.riseexperts.de/mcp",
      "headers": {
        "Authorization": "Bearer ${TWENTY_RISE_API_KEY}"
      }
    },
    "postgres": {
      "type": "stdio",
      "command": "bash",
      "args": ["-c", "source packages/twenty-server/.env && npx -y @modelcontextprotocol/server-postgres \"$PG_DATABASE_URL\""],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--no-sandbox", "--headless"],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    }
  }
}
